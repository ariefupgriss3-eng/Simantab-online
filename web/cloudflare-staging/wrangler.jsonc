{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "simantab-cloudflare-staging",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
